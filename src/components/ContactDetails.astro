---
// Contact card.
//   compact (home page): address, two navigation links, the social profiles and a
//                        link to the Contact page. WhatsApp and Call buttons are
//                        shown on desktop only (phones have them in the sticky bar).
//   full (Contact page): address and four action tiles (WhatsApp, call, Waze,
//                        Google Maps). Social profiles are separate cards there
//                        (SocialCards.astro).
import Icon from './Icon.astro';
import { site, telLink, whatsappLink } from '../config/site';
import { localePath, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  compact?: boolean;
}

const { locale, compact = false } = Astro.props;
const t = useTranslations(locale);

const tiles = [
  { icon: 'whatsapp', label: t.common.whatsapp, sub: t.common.sendWhatsapp, href: whatsappLink(t.wa.general), ltr: false, external: true },
  { icon: 'phone', label: t.common.phone, sub: site.phone.display, href: telLink, ltr: true, external: false },
  { icon: 'navigation', label: 'Waze', sub: t.common.navigate, href: site.maps.waze, ltr: false, external: true },
  { icon: 'pin', label: 'Google Maps', sub: t.common.map, href: site.maps.google, ltr: false, external: true },
] as const;

const profiles = [
  { icon: 'instagram', label: t.common.instagram, href: site.social.instagram },
  { icon: 'facebook', label: t.common.facebook, href: site.social.facebook },
  { icon: 'google', label: 'Google', href: site.googleProfile },
].filter((p) => p.href) as { icon: 'instagram' | 'facebook' | 'google'; label: string; href: string }[];
---

<p class="contact-address">
  <Icon name="pin" size={18} />
  <span>
    <span class="sr-only">{t.common.address}: </span>
    {t.common.addressText}
  </span>
</p>

{
  compact ? (
    <>
      {/* Phones already have WhatsApp and Call in the sticky bar, so these two show on desktop only. */}
      <div class="contact-actions desktop-only">
        <a class="btn btn-primary" href={whatsappLink(t.wa.general)} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          {t.common.whatsapp}
        </a>
        <a class="btn btn-secondary" href={telLink}>
          <Icon name="phone" />
          <bdi dir="ltr">{site.phone.display}</bdi>
        </a>
      </div>
      <div class="contact-nav">
        <a class="btn btn-tonal btn-sm" href={site.maps.waze} target="_blank" rel="noopener">
          <Icon name="navigation" />
          Waze
        </a>
        <a class="btn btn-tonal btn-sm" href={site.maps.google} target="_blank" rel="noopener">
          <Icon name="pin" />
          Google Maps
        </a>
      </div>
      {profiles.length > 0 && (
        <ul class="contact-social" aria-label={t.common.followUs}>
          {profiles.map((profile) => (
            <li>
              <a href={profile.href} target="_blank" rel="noopener">
                <span class="icon-badge">
                  <Icon name={profile.icon} size={20} />
                </span>
                {profile.label}
              </a>
            </li>
          ))}
        </ul>
      )}
      <a class="contact-all" href={localePath(locale, '/contact/')}>
        {t.home.visit.more}
        <Icon name="arrow" size={14} class="icon-dir" />
      </a>
    </>
  ) : (
    <ul class="contact-tiles">
      {tiles.map((tile) => (
        <li>
          <a
            class="contact-tile"
            href={tile.href}
            target={tile.external ? '_blank' : undefined}
            rel={tile.external ? 'noopener' : undefined}
          >
            <span class="icon-badge">
              <Icon name={tile.icon} size={20} />
            </span>
            <span class="tile-label">{tile.label}</span>
            <span class="tile-sub">{tile.ltr ? <bdi dir="ltr">{tile.sub}</bdi> : tile.sub}</span>
          </a>
        </li>
      ))}
    </ul>
  )
}
