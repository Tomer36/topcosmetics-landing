---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { localeCodes, localePath, locales, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  path: string;
  bookHref: string;
}

const { locale, path, bookHref } = Astro.props;
const t = useTranslations(locale);

const links = [
  { href: localePath(locale, '/'), label: t.nav.home, current: path === '/' },
  { href: localePath(locale, '/services/'), label: t.nav.services, current: path.startsWith('/services/') },
  { href: localePath(locale, '/about/'), label: t.nav.about, current: path === '/about/' },
  { href: localePath(locale, '/gallery/'), label: t.nav.gallery, current: path === '/gallery/' },
  { href: localePath(locale, '/contact/'), label: t.nav.contact, current: path === '/contact/' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label={t.nav.openMenu}
      data-menu-toggle
      data-open-label={t.nav.openMenu}
      data-close-label={t.nav.closeMenu}
    >
      <Icon name="menu" size={24} class="icon-open" />
      <Icon name="close" size={24} class="icon-close" />
    </button>

    <Logo locale={locale} />

    <nav class="site-nav" id="site-nav" aria-label={t.nav.main}>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={link.current ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <div class="lang-switch" role="group" aria-label={t.nav.language}>
        {
          localeCodes.map((code) => (
            <a
              href={localePath(code, path)}
              lang={code}
              hreflang={code}
              aria-label={locales[code].name}
              aria-current={code === locale ? 'true' : undefined}
            >
              <span>{locales[code].label}</span>
            </a>
          ))
        }
      </div>
      <a class="btn btn-primary btn-sm" href={bookHref} target="_blank" rel="noopener">{t.nav.book}</a>
    </div>
  </div>
</header>
