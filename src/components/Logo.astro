---
// Header and footer use the horizontal logo; on mobile the header shows the face icon only.
// Both are generated from the original artwork by `npm run logo`.
import { Image } from 'astro:assets';
import full from '../assets/logo-full.png';
import face from '../assets/logo-face.png';
import { localePath, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  variant?: 'header' | 'footer';
}

const { locale, variant = 'header' } = Astro.props;
const t = useTranslations(locale);
const src = full;
const height = variant === 'footer' ? 72 : 58;
const faceHeight = 50;
---

<a class:list={['logo', `logo-${variant}`]} href={localePath(locale, '/')}>
  <Image
    class="logo-full"
    src={src}
    alt={t.site.name}
    height={height}
    width={Math.round((src.width / src.height) * height)}
    densities={[1, 2, 3]}
    format="webp"
    loading={variant === 'footer' ? 'lazy' : 'eager'}
  />
  {
    variant === 'header' && (
      <Image
        class="logo-face"
        src={face}
        alt={t.site.name}
        height={faceHeight}
        width={Math.round((face.width / face.height) * faceHeight)}
        densities={[1, 2, 3]}
        format="webp"
        loading="eager"
      />
    )
  }
</a>
