---
// Full photo gallery: every image in src/assets/gallery/ (see src/config/gallery.ts).
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import Cta from '../../components/Cta.astro';
import { localeStaticPaths, useTranslations, type Locale } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Base locale={locale} title={t.gallery.seo.title} description={t.gallery.seo.description} path="/gallery/">
  <section class="page-head">
    <div class="container">
      <h1>{t.gallery.title}</h1>
      <p class="lead">{t.gallery.lead}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Gallery locale={locale} />
    </div>
  </section>

  <Cta locale={locale} />
</Base>
