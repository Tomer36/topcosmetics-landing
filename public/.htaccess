# Top Cosmetics Clinic — static site on Hostinger (LiteSpeed / Apache)

ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Arabic used to live under /ar/ and is now the default language at /
  # Match the complete prefix only; an absolute target cannot become //another-host.
  RewriteRule ^ar(?:/(.*))?$ https://topcosmeticsclinic.com/$1 [R=301,L]

  # One fixed canonical host and HTTPS, without trusting a client-supplied
  # X-Forwarded-Proto header. Cloudflare must use Full (strict), never Flexible.
  # The SSL certificate must be active for both apex and www before deployment.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^topcosmeticsclinic\.com$ [NC]
  RewriteRule ^ https://topcosmeticsclinic.com%{REQUEST_URI} [L,R=301]
</IfModule>

# Cache: hashed assets for a year, HTML never stale
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|webp|avif|jpg|jpeg|png|svg|ico|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(favicon\.(svg|png)|apple-touch-icon\.png|og-image\.jpg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Narrow, compatible policy: does not change the site's inline scripts/styles
  # or optional consent-based analytics. A full script policy needs separate testing.
  Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'"

  <Files "404.html">
    Header always set X-Robots-Tag "noindex, follow"
  </Files>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp
AddDefaultCharset UTF-8
